import java.util.*;

class Main {

    static class TreeNode {
        int data;
        TreeNode left, right;

        TreeNode(int data) {
            this.data = data;
        }
    }

    static TreeNode buildTree(int[] arr) {
        if (arr.length == 0 || arr[0] == -1)
            return null;

        TreeNode root = new TreeNode(arr[0]);
        Queue<TreeNode> queue = new LinkedList<>();
        queue.add(root);

        int i = 1;

        while (i < arr.length && !queue.isEmpty()) {
            TreeNode current = queue.poll();

            if (i < arr.length && arr[i] != -1) {
                current.left = new TreeNode(arr[i]);
                queue.add(current.left);
            }
            i++;

            if (i < arr.length && arr[i] != -1) {
                current.right = new TreeNode(arr[i]);
                queue.add(current.right);
            }
            i++;
        }

        return root;
    }

    static boolean findPath(TreeNode root, int value, List<TreeNode> path) {
        if (root == null)
            return false;

        path.add(root);

        if (root.data == value)
            return true;

        if (findPath(root.left, value, path) ||
            findPath(root.right, value, path)) {
            return true;
        }

        path.remove(path.size() - 1);
        return false;
    }

    static TreeNode findLCA(TreeNode root, int node1, int node2) {
        List<TreeNode> path1 = new ArrayList<>();
        List<TreeNode> path2 = new ArrayList<>();

        findPath(root, node1, path1);
        findPath(root, node2, path2);

        TreeNode lca = null;
        int i = 0;

        while (i < path1.size() && i < path2.size()) {
            if (path1.get(i).data != path2.get(i).data)
                break;

            lca = path1.get(i);
            i++;
        }

        return lca;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();

        int[] arr = new int[N];

        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
        }

        int node1 = sc.nextInt();
        int node2 = sc.nextInt();

        TreeNode root = buildTree(arr);

        TreeNode lca = findLCA(root, node1, node2);

        System.out.println("LCA = " + lca.data);
    }
}
